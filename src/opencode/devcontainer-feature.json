{
    "name": "opencode",
    "id": "sopi.opencode",
    "version": "0.0.2",
    "description": "Install opencode to devcontainers - Software Pioniere Style",
    "documentationURL": "https://opencode.ai",
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "mounts": [
        {
            "source": "${localEnv:HOME}/.ai-secrets",
            "target": "/home/vscode/.ai-secrets",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.config/opencode/opencode.jsonc",
            "target": "/home/vscode/.config/opencode/opencode.jsonc",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.config/opencode/plugins",
            "target": "/home/vscode/.config/opencode/plugins",
            "type": "bind"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "sst-dev.opencode"
            ]
        }
    }
}